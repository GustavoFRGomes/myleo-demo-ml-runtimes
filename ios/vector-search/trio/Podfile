platform :ios, '17.0'
use_frameworks!

target 'MyLeoVSTrio' do
  # Raw LiteRT runtime (Swift Interpreter API).
  pod 'TensorFlowLiteSwift', '~> 2.17.0'
  # ONNX Runtime (ObjC API, CPU + Core ML).
  pod 'onnxruntime-objc', '~> 1.30.0'

  target 'MyLeoVSTrioTests' do
    inherit! :search_paths
  end
end

# Pods below Xcode 26's minimum deployment target get bumped here.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end
end
