platform :ios, '17.0'
use_frameworks!

target 'MyLeoLLMOnnxGenAI' do
  # onnxruntime-genai ships prebuilt iOS pod-archives rather than a trunk spec,
  # so we point CocoaPods at a local podspec whose source is the release zip.
  pod 'onnxruntime-genai-c', :podspec => 'podspec/onnxruntime-genai-c.podspec'

  target 'MyLeoLLMOnnxGenAITests' do
    inherit! :search_paths
  end
end

# Pods below Xcode 26's minimum deployment target get bumped here.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end
end
