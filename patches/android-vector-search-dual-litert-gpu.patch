+package org.ggomes.myleo.vectorsearch.dual.data
+
+/** Execution provider requested for the LiteRT session. */
+enum class LiteRtExecutionProvider(val label: String) {
+    CPU("cpu"),
+    GPU("gpu");
+
+    companion object {
+        /** `--es litert_ep gpu` on the launch intent; anything else is CPU. */
+        fun fromExtra(value: String?): LiteRtExecutionProvider =
+            entries.firstOrNull { it.label == value?.trim()?.lowercase() } ?: CPU
+    }
+}
