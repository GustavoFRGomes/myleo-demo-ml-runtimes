+package org.ggomes.myleo.vectorsearch.dual.data
+
+import android.content.Context
+import android.util.Log
+import com.google.ai.edge.litert.Accelerator
+import com.google.ai.edge.litert.CompiledModel
+
+/**
+ * [InferenceRunner] over LiteRT's `CompiledModel` API — the only path in
+ * `litert:2.2.0` that can use the GPU accelerator (`litert-api` ships
+ * `GpuOptions`; the legacy `Interpreter` in the same AAR has no delegate
+ * classes). The AAR also ships `libLiteRtClGlAccelerator.so`, i.e. OpenCL/GL.
+ *
+ * The graph is the same MiniLM `.tflite` as the CPU path: INT32
+ * `[1 x seqLen]` ids/mask/segment in, float `[1 x seqLen x dim]` out,
+ * mean-pooled here. Tensor *names* are probed rather than assumed, because
+ * order and naming vary per converter; the output width is derived from the
+ * buffer length and the known sequence length (`TensorType` exposes no shape).
+ */
+class CompiledModelRunner private constructor(
+    private val model: CompiledModel,
+    private val idsName: String,
+    private val maskName: String,
+    private val segmentName: String,
+    private val outputName: String,
+    private val seqLen: Int,
+) : InferenceRunner {
+
+    private val idsBuffer = model.createInputBuffer(idsName, "")
+    private val maskBuffer = model.createInputBuffer(maskName, "")
+    private val segmentBuffer = model.createInputBuffer(segmentName, "")
+    private val outputBuffer = model.createOutputBuffer(outputName, "")
+
+    override fun runEmbedding(ids: IntArray, mask: IntArray, segmentIds: IntArray): FloatArray {
+        idsBuffer.writeInt(ids)
+        maskBuffer.writeInt(mask)
+        segmentBuffer.writeInt(segmentIds)
+        model.run(
+            mapOf(idsName to idsBuffer, maskName to maskBuffer, segmentName to segmentBuffer),
+            mapOf(outputName to outputBuffer),
+            "",
+        )
+        val flat = outputBuffer.readFloat()
+        require(flat.size % seqLen == 0) {
+            "unexpected output size ${flat.size} for seqLen $seqLen"
+        }
+        val dim = flat.size / seqLen
+        return meanPool(flat, seqLen, dim, mask)
+    }
+
+    override fun close() {
+        idsBuffer.close()
+        maskBuffer.close()
+        segmentBuffer.close()
+        outputBuffer.close()
+        model.close()
+    }
+
+    companion object {
+        private const val TAG = "MyLeo-LiteRt"
+
+        private val ID_NAMES = listOf("input_ids", "ids", "input_word_ids")
+        private val MASK_NAMES = listOf("attention_mask", "mask", "input_mask")
+        private val SEGMENT_NAMES = listOf("token_type_ids", "segment_ids", "input_type_ids")
+        private val OUTPUT_NAMES = listOf("last_hidden_state", "Identity", "output", "embedding")
+
+        /**
+         * Builds a GPU-backed runner. Throws on any failure so the factory can fall
+         * back to the CPU `Interpreter` path — a `CompiledModel` with a GPU
+         * accelerator either initialises or it does not, and a partially delegated
+         * graph still runs on whatever the accelerator keeps.
+         */
+        fun createGpu(context: Context, assetPath: String, seqLen: Int): CompiledModelRunner {
+            runCatching {
+                val env = com.google.ai.edge.litert.Environment.create(context)
+                Log.i(TAG, "available accelerators: ${env.getAvailableAccelerators()}")
+            }.onFailure { Log.w(TAG, "environment probe failed: ${it.message}") }
+
+            val variants = listOf(
+                "fp16" to CompiledModel.GpuOptions.Precision.FP16,
+                "default" to CompiledModel.GpuOptions.Precision.DEFAULT,
+                "fp32" to CompiledModel.GpuOptions.Precision.FP32,
+            )
+            // Assets are opened by fd; also try a cache copy so an fd/offset quirk
+            // cannot masquerade as a compile failure.
+            val cacheCopy = runCatching {
+                val file = java.io.File(context.cacheDir, "embedding-gpu.tflite")
+                if (!file.exists() || file.length() == 0L) {
+                    context.assets.open(assetPath).use { input ->
+                        file.outputStream().use { output -> input.copyTo(output) }
+                    }
+                }
+                file.absolutePath
+            }.getOrNull()
+            var lastError: Exception? = null
+            for ((label, precision) in variants) {
+                val options = CompiledModel.Options(Accelerator.GPU).apply {
+                    gpuOptions = CompiledModel.GpuOptions(precision = precision)
+                }
+                val model = try {
+                    if (cacheCopy != null) {
+                        CompiledModel.create(cacheCopy, options)
+                    } else {
+                        CompiledModel.create(context.assets, assetPath, options)
+                    }
+                } catch (e: Exception) {
+                    Log.w(TAG, "GPU create ($label) failed: ${e.message}")
+                    lastError = e
+                    continue
+                }
+                try {
+                    val ids = probe(model, ID_NAMES, input = true)
+                    val mask = probe(model, MASK_NAMES, input = true)
+                    val segment = probe(model, SEGMENT_NAMES, input = true)
+                    val output = probe(model, OUTPUT_NAMES, input = false)
+                    Log.i(TAG, "GPU model compiled ($label): in=$ids/$mask/$segment out=$output")
+                    return CompiledModelRunner(model, ids, mask, segment, output, seqLen)
+                } catch (e: Exception) {
+                    model.close()
+                    throw IllegalStateException("GPU model prepared but unusable: ${e.message}", e)
+                }
+            }
+            throw IllegalStateException(
+                "GPU CompiledModel create failed for all precisions: ${lastError?.message}",
+                lastError,
+            )
+        }
+
+        /** First candidate name the model actually declares, else a clear error. */
+        private fun probe(model: CompiledModel, names: List<String>, input: Boolean): String {
+            for (name in names) {
+                val type = runCatching {
+                    if (input) model.getInputTensorType(name, "") else model.getOutputTensorType(name, "")
+                }.getOrNull()
+                if (type != null) return name
+            }
+            throw IllegalStateException(
+                "${if (input) "input" else "output"} not found; tried ${names.joinToString(", ")}",
+            )
+        }
+    }
+}
