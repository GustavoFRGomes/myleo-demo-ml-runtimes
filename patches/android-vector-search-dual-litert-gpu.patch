+package org.ggomes.myleo.vectorsearch.dual.data
+
+import org.assertj.core.api.Assertions.assertThat
+import org.junit.Test
+
+/** Pure mapping from the launch-extra to the requested LiteRT execution provider. */
+class LiteRtExecutionProviderTest {
+
+    @Test
+    fun fromExtra_gpu_isGpu() {
+        assertThat(LiteRtExecutionProvider.fromExtra("gpu")).isEqualTo(LiteRtExecutionProvider.GPU)
+    }
+
+    @Test
+    fun fromExtra_mixedCaseAndSpaces_isGpu() {
+        assertThat(LiteRtExecutionProvider.fromExtra(" GPU ")).isEqualTo(LiteRtExecutionProvider.GPU)
+    }
+
+    @Test
+    fun fromExtra_null_isCpu() {
+        assertThat(LiteRtExecutionProvider.fromExtra(null)).isEqualTo(LiteRtExecutionProvider.CPU)
+    }
+
+    @Test
+    fun fromExtra_unknown_isCpu() {
+        assertThat(LiteRtExecutionProvider.fromExtra("npu")).isEqualTo(LiteRtExecutionProvider.CPU)
+    }
+}
