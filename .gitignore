# Android Studio / IntelliJ — never commit IDE-local state
.idea/
*.iml

# Gradle caches and build outputs (per-leaf .gitignore files repeat these;
# this root file is the repo-wide safety net)
.gradle/
.kotlin/
build/

# Machine-specific Android SDK location (generated by Android Studio)
local.properties

# Datasets are never committed (see leaf READMEs for provenance + extraction)
*.csv

# Xcode: generated projects are rebuilt from project.yml via XcodeGen
*.xcodeproj/

# CocoaPods: Podfile + Podfile.lock are tracked; the rest regenerates locally
Pods/
*.xcworkspace

# macOS
.DS_Store
